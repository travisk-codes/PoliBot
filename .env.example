# Discord application credentials (https://discord.com/developers/applications)
# Bot token: Bot page -> Token -> Reset Token, then copy. A long secret string,
# shown only once. NOT the Application ID. Never commit or share it.
DISCORD_TOKEN=
# Application ID: General Information page -> "Application ID" (a number).
# Same value as "Client ID" on the OAuth2 page.
DISCORD_CLIENT_ID=
# Optional server ID: in Discord, User Settings -> Advanced -> Developer Mode on,
# then right-click your server -> Copy Server ID.
# Set it to register commands to that one server instantly during development.
# Leave empty to register globally (can take up to an hour to propagate).
DISCORD_GUILD_ID=

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
